# Copy to .env (gitignored, chmod 600). Never commit real values.
# Keychain holds the things tools read directly (notarytool profile, Sparkle EdDSA key)
# and every account password (generic password tegel-<service>, master roadmap §6);
# this file records what they are and holds API tokens scripts need.

# --- Accounts (login email + where 2FA lives; passwords are in the Keychain) ---
STUDIO_EMAIL=
CLOUDFLARE_EMAIL=
POLAR_EMAIL=

# --- Apple (Developer ID + notarisation) ---
APPLE_TEAM_ID=
APPLE_DEVELOPER_ID_IDENTITY="Developer ID Application: <Name> (<TEAMID>)"
NOTARY_KEYCHAIN_PROFILE=tegel-notary
ASC_API_KEY_ID=
ASC_API_ISSUER_ID=
ASC_API_KEY_PATH=          # absolute path to AuthKey_<id>.p8, kept OUTSIDE the repo

# --- Sparkle (private key lives in the login Keychain; backup file kept outside the repo) ---
SPARKLE_PUBLIC_ED_KEY=
SPARKLE_PRIVATE_KEY_BACKUP_PATH=

# --- Polar (organization id is public by design; tokens are not) ---
POLAR_ORGANIZATION_ID=
POLAR_SANDBOX_ORGANIZATION_ID=
POLAR_ACCESS_TOKEN=        # live org access token (server-side scripts only, never in the app)
POLAR_SANDBOX_ACCESS_TOKEN=
POLAR_CHECKOUT_URL_MARKDOWN=
POLAR_SANDBOX_CHECKOUT_URL_MARKDOWN=

# --- Cloudflare (Pages + R2 + DNS) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=      # tegel-pages-deploy: Pages Edit only, TTL to 30 Apr 2027 (K2); R2 uses CLOUDFLARE_R2_API_TOKEN; DNS is done by hand
R2_BUCKET=tegel-downloads
R2_PUBLIC_BASE_URL=https://downloads.tegelapps.com

# --- Remote Apple Silicon test Mac (macOS 26/27) ---
REMOTE_MAC_HOST=
REMOTE_MAC_USER=
REMOTE_MAC_PASSWORD=

# --- Apple Account ---
APPLE_ACCOUNT_EMAIL=
APPLE_ENROLLMENT_ID=
APPLE_ORDER_NUMBER=
APPLE_DEVELOPER_LEGAL_NAME=
KVK_NUMBER=
VAT_ID=                    # btw-id shown on the imprint (public)
